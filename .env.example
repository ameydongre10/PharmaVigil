# ===========================================================================
# GenAR AI Engineering Challenge - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to Git.
# ===========================================================================

# LLM Provider Configuration
# Supported providers: openai, anthropic, gemini, generic
LLM_PROVIDER=openai

# LLM API Key (required for live generation, offline mock used if omitted)
LLM_API_KEY=your_api_key_here

# Model Identifier
LLM_MODEL=gpt-4o-mini

# Optional Configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# Authentication demo only: set true locally to create known demo accounts.
# Never enable this on a public or production deployment.
PHARMAVIGIL_SEED_DEMO_USERS=false

# Set a long random secret in deployments to sign review records consistently.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PHARMAVIGIL_SIGNING_KEY=
